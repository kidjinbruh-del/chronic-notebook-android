<?xml version="1.0" encoding="utf-8"?>
<!-- Иконка для Android 6–7, где адаптивных ещё нет (minSdk 23).
     Раньше здесь стоял отдельный вектор с собственной зелёной заливкой и
     старыми столбиками: рисунок жил в двух местах и со временем разошёлся с
     адаптивной иконкой. Теперь это слой из того же цвета и того же переднего
     плана — менять придётся один файл. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>