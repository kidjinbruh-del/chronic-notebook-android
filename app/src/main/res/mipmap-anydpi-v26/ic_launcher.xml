<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- monochrome нужен для тематических иконок Android 13+: система берёт из
         слоя только альфу и красит силуэт цветом темы. Раньше этого тега не
         было, и приложение просто не появлялось в списке тематических иконок. -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>